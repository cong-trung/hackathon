# Copy to .env.production in hackathon-backend/ for native (non-Docker) runs:
#     cp .env.example .env.production
# In Docker Compose, use the root .env.production instead (see / .env.example).

# Optional NYRA AI chat gateway (leave empty to disable chat). Install the SDK
# from the Intel git repository first:
#   pip install "nyra-services @ git+https://mfg-github.mfg.intel.com/intel-manufacturing/applications.manufacturing.intel.common.imi.api.nyra.nyra-services.git@main"
NYRA_API_KEY=
NYRA_CHAT_MODEL=deepseek-v4.1-flash

# Optional XRB export for the chat knowledge snapshot; defaults to
# <QUALITY_MATRIX_DATA_DIR>/XRB.csv. Read in the background and cached.
# QUALITY_MATRIX_XRB_PATH=\\VNATSHFS.intel.com\VNATAnalysis$\MAOATM\VN\Applications\TE\Quality\XRB.csv

# Auth signing secret; at least 32 characters:  openssl rand -hex 32
QUALITY_MATRIX_AUTH_SECRET=

# Initial admin account created on first startup.
QUALITY_MATRIX_ADMIN_USERNAME=admin
QUALITY_MATRIX_ADMIN_PASSWORD=

# Where CSV data lives. Local dev: "data". Container: "/app/data".
QUALITY_MATRIX_DATA_DIR=data

# Final-submit PdO notifications. MAIL_TRANSPORT: outlook | smtp | log. Unset defaults to smtp when SMTP_HOST is set,
# else outlook on Windows (desktop Outlook via pywin32), else log. MAIL_ENABLED=false forces log.
# Outlook transport works only with native Windows desktop Outlook (not Docker/Linux). For SMTP, the container must reach
# SMTP_HOST on port 25 or 587. Test delivery (sends one message, exit 0 = sent, 1 = failed):
#   docker exec -it <backend-container> python -m app.services.notification_service --test-to you@intel.com
#   Local Windows: .\.venv\Scripts\python.exe -m app.services.notification_service --test-to you@intel.com
QUALITY_MATRIX_MAIL_TRANSPORT=
QUALITY_MATRIX_MAIL_ENABLED=true
QUALITY_MATRIX_MAIL_FROM=no-reply@localhost
QUALITY_MATRIX_PUBLIC_URL=http://localhost:5173
QUALITY_MATRIX_SMTP_HOST=
QUALITY_MATRIX_SMTP_PORT=25
QUALITY_MATRIX_SMTP_STARTTLS=false
QUALITY_MATRIX_SMTP_USERNAME=
QUALITY_MATRIX_SMTP_PASSWORD=

# Optional corporate network proxies (Intel only).
# HTTP_PROXY=http://proxy-dmz.intel.com:911
# HTTPS_PROXY=http://proxy-dmz.intel.com:912
# FTP_PROXY=http://proxy-dmz.intel.com:911
# NO_PROXY=localhost,127.0.0.1,intel.com,.intel.com,.maas
