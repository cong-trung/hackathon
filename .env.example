# ============================================================
# Quality Matrix deployment configuration (Docker Compose)
# ============================================================
# Copy this file to .env.production in the repo ROOT and fill in real values:
#     cp .env.example .env.production
# Never commit the real .env.production; every .env* file is gitignored.

# --- Web UI ---
# Port the frontend (Express + built React) listens on.
PORT=8005

# URL the frontend proxy uses to reach the FastAPI backend. Inside Docker
# Compose the default already works; override only for non-Docker runs,
# e.g. http://127.0.0.1:8004.
DJANGO_BASE_URL=http://hackathon-backend:8004

# Key used to sign/encrypt client-side values. Generate a long random string
# and keep the same value for every build:  openssl rand -hex 32
VITE_ENCRYPTION_KEY=

# --- Backend runtime ---
# Where CSV data lives; inside the container use /app/data.
QUALITY_MATRIX_DATA_DIR=/app/data

# Public URL users open (used in links). Default http://quality-matrix-vnat.intel.com.
QUALITY_MATRIX_PUBLIC_URL=http://quality-matrix-vnat.intel.com

# Browser origins the frontend accepts for mutating API calls (comma-separated).
# Add the https:// origin too if the site is served over TLS.
FRONTEND_ALLOWED_ORIGINS=http://quality-matrix-vnat.intel.com,http://localhost:8005

# Set to true once the site is served over HTTPS; false for plain HTTP.
# Browsers drop Secure cookies over HTTP, which breaks login.
COOKIE_SECURE=false

# Mail. Leave QUALITY_MATRIX_MAIL_TRANSPORT empty in Docker: the Outlook transport
# needs Windows and falls back to logging on Linux. Set SMTP host to send mail.
# Defaults: relay SMTP.intel.com:25, no STARTTLS, no login, sender ba-chu-YP@intel.com.
QUALITY_MATRIX_MAIL_TRANSPORT=
QUALITY_MATRIX_MAIL_FROM=ba-chu-YP@intel.com
QUALITY_MATRIX_SMTP_HOST=SMTP.intel.com
QUALITY_MATRIX_SMTP_PORT=25
QUALITY_MATRIX_SMTP_STARTTLS=false
QUALITY_MATRIX_SMTP_USERNAME=
QUALITY_MATRIX_SMTP_PASSWORD=

# Auth signing secret; must be at least 32 characters:  openssl rand -hex 32
QUALITY_MATRIX_AUTH_SECRET=

# Initial admin account created on first startup.
QUALITY_MATRIX_ADMIN_USERNAME=admin
QUALITY_MATRIX_ADMIN_PASSWORD=

# --- NetApp share (Docker CIFS volume, required for production) ---
# Service account with read/write access to the Quality share. Use a dedicated
# least-privilege account: the options are visible in `docker volume inspect`
# to anyone with Docker access on the host.
# Password must not contain commas (CIFS option separator).
# Volume options are fixed at creation. After changing these values run:
#   docker compose --env-file .env.production down
#   docker volume rm <project>_quality_data
#   docker compose --env-file .env.production up -d
# The host kernel needs CIFS support; install cifs-utils if the mount fails.
QUALITY_SHARE_USERNAME=
QUALITY_SHARE_PASSWORD=
# Only set if the account needs a domain, e.g. CCR or GAR.
QUALITY_SHARE_DOMAIN=
# SMB protocol version. Try 2.1 if the mount fails with error(112) Host is down.
QUALITY_SHARE_SMB_VERSION=3.0

# --- Optional NYRA AI chat ---
# Leave NYRA_API_KEY empty to disable the chat feature entirely.
NYRA_API_KEY=
NYRA_CHAT_MODEL=deepseek-v4.1-flash

# mfg-github token (read access to nyra-services); build-time only
NYRA_GIT_TOKEN=

# Optional path to the XRB export used by the chat knowledge snapshot. The
# backend reads it in the background (large file) to answer XRB questions with
# real statuses/types/module counts. Defaults to <QUALITY_MATRIX_DATA_DIR>/XRB.csv.
# QUALITY_MATRIX_XRB_PATH=\\fileserver\share\Quality\XRB.csv

# At build time, nyra-services is installed from the private Intel git repository.
# Without a token the build still succeeds with chat disabled. Manual build with a
# GitHub PAT (read access to nyra-services), not stored in the image:
#   docker build --secret id=nyra_git_token,env=NYRA_GIT_TOKEN -t hackathon-backend:latest ./hackathon-backend
# Skip the install entirely: NYRA_PACKAGE_URL= docker compose up -d --build
# NYRA_PACKAGE_URL=git+https://mfg-github.mfg.intel.com/intel-manufacturing/applications.manufacturing.intel.common.imi.api.nyra.nyra-services.git@main

# --- Optional corporate network proxies (Intel only) ---
# HTTP_PROXY=http://proxy-dmz.intel.com:911
# HTTPS_PROXY=http://proxy-dmz.intel.com:912
# FTP_PROXY=http://proxy-dmz.intel.com:911
# NO_PROXY=localhost,127.0.0.1,intel.com,.intel.com,.maas,10.0.0.0/8,172.16.0.0/16,172.19.0.0/16,192.168.0.0/16,134.134.0.0/16,.maas-internal,hackathon-backend,hackathon-frontend
