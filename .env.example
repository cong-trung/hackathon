# ============================================================
# Quality Matrix deployment configuration (Docker Compose)
# ============================================================
# Copy this file to .env.production in the repo ROOT and fill in real values:
#     cp .env.example .env.production
# Never commit the real .env.production; every .env* file is gitignored.

# --- Web UI ---
# Port the frontend (Express + built React) listens on.
PORT=8005

# URL the frontend proxy uses to reach the FastAPI backend. Inside Docker
# Compose the default already works; override only for non-Docker runs,
# e.g. http://127.0.0.1:8004.
DJANGO_BASE_URL=http://hackathon-backend:8004

# Key used to sign/encrypt client-side values. Generate a long random string
# and keep the same value for every build:  openssl rand -hex 32
VITE_ENCRYPTION_KEY=

# --- Backend runtime ---
# Where CSV data lives; inside the container use /app/data.
QUALITY_MATRIX_DATA_DIR=/app/data

# Auth signing secret; must be at least 32 characters:  openssl rand -hex 32
QUALITY_MATRIX_AUTH_SECRET=

# Initial admin account created on first startup.
QUALITY_MATRIX_ADMIN_USERNAME=admin
QUALITY_MATRIX_ADMIN_PASSWORD=

# --- Optional NYRA AI chat ---
# Leave NYRA_API_KEY empty (and set NYRA_INDEX_URL= at build time) to disable
# the chat feature entirely.
NYRA_API_KEY=
NYRA_CHAT_MODEL=gemma-4-31b-it

# At build time, nyra-services is pulled from an internal package index.
# Outside the Intel network set this to empty in the shell used for build:
#   NYRA_INDEX_URL= docker compose up -d --build
# NYRA_INDEX_URL=https://devpi.intel.com/general/nyra/+simple/

# --- Optional corporate network proxies (Intel only) ---
# HTTP_PROXY=http://proxy-dmz.intel.com:911
# HTTPS_PROXY=http://proxy-dmz.intel.com:912
# FTP_PROXY=http://proxy-dmz.intel.com:911
# NO_PROXY=localhost,127.0.0.1,intel.com,.intel.com,.maas,10.0.0.0/8,172.16.0.0/16,172.19.0.0/16,192.168.0.0/16,134.134.0.0/16,.maas-internal,hackathon-backend,hackathon-frontend